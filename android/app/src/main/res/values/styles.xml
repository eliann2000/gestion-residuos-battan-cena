<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#167550</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F4F7F3</item>
        <item name="android:navigationBarColor">#173F30</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">#F4F7F3</item>
        <item name="android:buttonStyle">@style/Boton</item>
    </style>
    <style name="Boton" parent="android:style/Widget.Material.Button.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:backgroundTint">#167550</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:minHeight">48dp</item>
    </style>
    <style name="Campo" parent="android:style/Widget.Material.EditText">
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:padding">10dp</item>
        <item name="android:singleLine">true</item>
    </style>
</resources>
