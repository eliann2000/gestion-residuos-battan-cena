<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:fitsSystemWindows="true">
    <TextView android:id="@+id/titulo" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Mapa de recolección" android:textSize="24sp" android:textStyle="bold" android:textColor="#173F30" android:padding="18dp" />
    <TextView android:id="@+id/detalle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="14sp" android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="12dp" />
    <WebView android:id="@+id/mapa" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <Button android:id="@+id/volver" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/volver" android:layout_margin="12dp" />
</LinearLayout>
